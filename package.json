    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@fontsource/mynerve": "^5.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
